# .env is the SAFE LOCAL DEFAULT: point it at an isolated Postgres schema
# (e.g. append `&schema=dev` / `?schema=dev` to a Supabase connection string),
# never at the schema production actually reads (usually "public"). This is
# what `npm run dev`, `prisma db push`, and `npm run db:seed` use by default.
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=dev"
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=dev"
ROOT_DOMAIN=localhost
# Optional: served when no tenant subdomain resolves (apex domain, preview URLs, etc.)
DEFAULT_TENANT_SUBDOMAIN=cinthia
JWT_SECRET="generate-a-random-secret-and-put-it-here"
# Optional: real password for the seeded admin user (prisma/seed.ts). Without
# it, seeding falls back to an insecure placeholder -- never commit a real
# value here, set it only in the untracked env file you seed with.
SEED_ADMIN_PASSWORD=""
# Use Supabase's pooler host (Session mode, port 5432, username
# "postgres.<project-ref>"), not the direct "db.<ref>.supabase.co" host --
# the direct host is IPv6-only and unreachable from GitHub Actions and most
# other IPv4-only CI runners, which fails with Prisma error P1001.
TEST_DATABASE_URL="postgresql://postgres.<project-ref>:password@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=test"

# Real production credentials (schema=public / no schema param) belong in
# .env.production.local instead -- never in plain .env. It's already
# git-ignored. To run a one-off command against production on purpose, use:
#   node scripts/with-env.js .env.production.local "npm run db:seed"
# or the shortcuts: npm run db:push:prod / db:seed:prod / db:studio:prod

# Free-tier Google Gemini key for the public-site AI assistant
# (src/app/api/assistant/route.ts). Generate one at
# https://aistudio.google.com/apikey -- it's free, no credit card needed.
GOOGLE_GENERATIVE_AI_API_KEY=""
