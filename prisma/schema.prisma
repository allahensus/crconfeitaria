datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  subdomain String   @unique
  status    String   @default("ACTIVE") // TRIAL, ACTIVE, SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  categories            Category[]
  products              Product[]
  fillingOptions        FillingOption[]
  customers             Customer[]
  quotes                Quote[]
  orders                Order[]
  expenses              Expense[]
  financialTransactions FinancialTransaction[]
  settings              Setting[]
  testimonials          Testimonial[]
  ingredients           Ingredient[]
  blockedDates          BlockedDate[]
  coupons               Coupon[]
  galleryItems          GalleryItem[]
}

model User {
  id        String   @id @default(uuid())
  email     String
  name      String
  password  String
  role      String   @default("OWNER")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String
  description String?
  order       Int       @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([organizationId, slug])
}

model Product {
  id          String             @id @default(uuid())
  name        String
  slug        String
  categoryId  String
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  description String
  mainImage   String
  imageFit    String             @default("contain") // "contain" (full photo, no crop) or "cover" (manual zoom/position)
  imageZoom   Float              @default(1) // used when imageFit = "cover"
  imagePosX   Float              @default(50) // 0-100, used when imageFit = "cover"
  imagePosY   Float              @default(50) // 0-100, used when imageFit = "cover"
  gallery     String?            // JSON string array
  basePrice   Float
  unit        String             @default("unidade") // unidade, kg, etc.
  yieldInfo   String?            // ex: "7 fatias", "450g (2 pessoas)"
  active      Boolean            @default(true)
  featured    Boolean            @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variations  ProductVariation[]
  recipeItems RecipeItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([organizationId, slug])
}

model ProductVariation {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // ex: "13 a 15 fatias", "Buttercream", "6cm"
  price     Float
  slices    String?  // ex: "13-15 fatias"
  weight    String?  // ex: "1kg"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FillingOption {
  id          String   @id @default(uuid())
  name        String
  category    String   @default("Geral") // ex: "Tradicional", "Gourmet", "Frutas"
  extraPrice  Float    @default(0.0)
  active      Boolean  @default(true)
  description String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
}

model Customer {
  id           String    @id @default(uuid())
  name         String
  whatsapp     String
  email        String?
  cpf          String?
  address      String?
  birthDate    DateTime?
  lgpdAccepted Boolean   @default(true)
  notes        String?
  totalSpent   Float     @default(0.0)
  ordersCount  Int       @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotes       Quote[]
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([organizationId, whatsapp])
}

model Quote {
  id               String      @id @default(uuid())
  quoteNumber      String // ex: ORC-2026-0001
  customerId       String?
  customer         Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  customerWhatsapp String
  eventDate        DateTime?
  preferredPaymentMethod String? // Pix, Cartão de Crédito, Dinheiro -- how the customer said they'd pay
  themeNotes       String?
  subtotal         Float
  discount         Float       @default(0.0)
  couponCode       String?
  extraTotal       Float       @default(0.0)
  finalTotal       Float
  depositAmount    Float? // sinal sugerido (finalTotal x % configurado em Configurações no momento do envio)
  status           String      @default("PENDING") // PENDING, APPROVED, CONVERTED, REJECTED
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items            QuoteItem[]
  order            Order?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([organizationId, quoteNumber])
}

model QuoteItem {
  id          String   @id @default(uuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  variation   String?
  cakeBase    String?  // Baunilha, Chocolate
  filling1    String?
  filling2    String?
  frosting    String?  // Chantily, Buttercream
  extras      String?  // Topper, Palito, etc.
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
}

model Order {
  id               String                 @id @default(uuid())
  orderNumber      String // ex: PED-2026-0001
  quoteId          String?                @unique
  quote            Quote?                 @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  customerWhatsapp String
  preferredPaymentMethod String? // carried over from the quote, if any
  depositAmount    Float? // carried over from the quote, if any
  deliveryDate     DateTime
  status           String                 @default("NOVO") // NOVO, AGUARDANDO_CONFIRMACAO, CONFIRMADO, PAGAMENTO_PENDENTE, EM_PRODUCAO, PRONTO, ENTREGUE, CANCELADO
  totalAmount      Float
  paidAmount       Float                  @default(0.0)
  paymentStatus    String                 @default("PENDENTE") // PENDENTE, PARCIAL, PAGO
  stockDeducted    Boolean                @default(false) // true while this order's recipe ingredients are deducted from stock
  notes            String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items            OrderItem[]
  payments         Payment[]
  transactions     FinancialTransaction[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([organizationId, orderNumber])
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String? // links to the catalog Product, when known -- see src/lib/stock.ts
  productName   String
  variationName String?
  cakeBase      String?
  filling1      String?
  filling2      String?
  quantity      Int     @default(1)
  unitPrice     Float
  totalPrice    Float
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod String   // Pix, Dinheiro, Cartao, Transferencia
  status        String   @default("CONFIRMADO")
  paidAt        DateTime @default(now())
  notes         String?
}

model Expense {
  id            String                 @id @default(uuid())
  description   String
  category      String                 // Ingredientes, Embalagens, Entregas, Energia, Equipamentos, Marketing, Outros
  amount        Float
  date          DateTime               @default(now())
  paymentMethod String                 @default("Pix")
  notes         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions  FinancialTransaction[]
  createdAt     DateTime               @default(now())

  @@index([organizationId])
}

model FinancialTransaction {
  id          String   @id @default(uuid())
  type        String   // RECEITA, DESPESA
  amount      Float
  category    String
  description String
  date        DateTime @default(now())
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  expenseId   String?
  expense     Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Setting {
  id    String @id @default(uuid())
  key   String
  value String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  eventType String
  comment   String
  rating    Int      @default(5)
  active    Boolean  @default(true)
  avatarUrl String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([organizationId])
}

model GalleryItem {
  id          String   @id @default(uuid())
  imageUrl    String
  caption     String?
  eventType   String
  imageZoom   Float    @default(1) // 1-2.5, scale applied on top of the cover crop
  imagePosX   Float    @default(50) // 0-100, object-position X for the cover crop
  imagePosY   Float    @default(50) // 0-100, object-position Y for the cover crop
  order       Int      @default(0)
  active      Boolean  @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
}

model Ingredient {
  id                String       @id @default(uuid())
  name              String
  unit              String       @default("g") // g, ml, un, kg
  packageQuantity   Float        // ex: 395 (g) no pacote
  costPrice         Float        // ex: 7.50 (preço pago no mercado)
  category          String       @default("Ingredientes") // Laticínios, Chocolates, Embalagens, etc.
  stockQuantity     Float        @default(0) // quanto tem em estoque hoje, na unidade acima
  lowStockThreshold Float        @default(0) // abaixo disso, mostra alerta de estoque baixo
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipeItems       RecipeItem[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId])
}

model RecipeItem {
  id           String     @id @default(uuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantityUsed Float      // ex: 150 (g usados por unidade de produto)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Coupon {
  id              String    @id @default(uuid())
  code            String // ex: "NIVER10" -- stored uppercase, matched case-insensitively
  discountType    String    @default("PERCENT") // PERCENT or FIXED
  discountValue   Float // 10 = 10% (PERCENT) or R$10,00 (FIXED)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  maxUses         Int? // null = sem limite total de usos
  oncePerCustomer Boolean   @default(true) // mesmo WhatsApp não pode reusar o código
  usageCount      Int       @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@unique([organizationId, code])
}

model BlockedDate {
  id             String   @id @default(uuid())
  date           DateTime // stored at midnight UTC, one row per unavailable calendar day
  reason         String?  // ex: "Agenda lotada", "Folga"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([organizationId, date])
}

